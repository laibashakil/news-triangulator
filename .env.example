# ──────────────────────────────────────────────────────────────────────
# News Triangulator — Environment Variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# The app uses two free services:
#   • Tavily — live news search       (https://app.tavily.com)
#   • Groq   — fast LLM synthesis      (https://console.groq.com)
# Both have free tiers and need no billing.
# ──────────────────────────────────────────────────────────────────────

# REQUIRED: free Tavily API key for live news search.
# Locally: set it here in .env.local. On Vercel: Project Settings → Env Vars.
TAVILY_API_KEY=your-tavily-key-here

# REQUIRED: free Groq API key for LLM synthesis.
GROQ_API_KEY=your-groq-key-here

# Optional: application URL (defaults to http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set automatically by Next.js — no need to configure manually
# NODE_ENV=development
