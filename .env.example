# ──────────────────────────────────────────────────────────────────────
# News Triangulator — Environment Variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Authentication uses the Gemini Developer API (free tier) via an API key.
# Create a free key at https://aistudio.google.com/apikey — no billing needed.
# ──────────────────────────────────────────────────────────────────────

# REQUIRED: your free Gemini API key from Google AI Studio.
# Locally: put it here in .env.local. On Vercel: add it under
# Project Settings → Environment Variables (same name).
GEMINI_API_KEY=your-api-key-here

# Optional: application URL (defaults to http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: enable the pre-flight "is this a news query?" validation call.
# Off by default to minimize free-tier quota usage.
# GEMINI_STORY_VALIDATION=true

# Set automatically by Next.js — no need to configure manually
# NODE_ENV=development
